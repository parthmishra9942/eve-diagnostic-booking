# Copy to .env for local (non-Docker) development.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eve_diagnostics
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
WEBHOOK_SECRET=change-me-webhook-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Payment simulation
PAYMENT_SUCCESS_RATE=0.9
ALLOW_PAYMENT_SIMULATION_OVERRIDE=true
WEBHOOK_AUTO_DISPATCH=true
WEBHOOK_DISPATCH_DELAY_SECONDS=0.5

# Rate limiting / cache
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
PAYMENT_RATE_LIMIT=30/minute
CACHE_TTL_SECONDS=60

# Optional: bootstrap an admin on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
